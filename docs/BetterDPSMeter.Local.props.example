<Project>
    <!-- Copy this file to src/BetterDPSMeter.Local.props. -->
    <PropertyGroup>
        <!-- Set TerrariaDirectory to the folder containing Terraria.exe. -->
        <TerrariaDirectory>C:\Path\To\Terraria</TerrariaDirectory>

        <!--
        Override only if Microsoft.Xna.Framework.Content.Pipeline.dll is not located
        in the Terraria installation directory.
        -->
        <!--
        <XnaContentPipelineDll>C:\Path\To\Microsoft.Xna.Framework.Content.Pipeline.dll</XnaContentPipelineDll>
        -->

        <!-- Enable automatic deployment after a successful build when desired. -->
        <DeployToGame>false</DeployToGame>

        <!-- The project derives this path from TerrariaDirectory. Change it only to deploy to a different folder. -->
        <TerrariaModDirectory>$(TerrariaDirectory)\TerrariaModder\mods\better-dps-meter</TerrariaModDirectory>
    </PropertyGroup>
</Project>