<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <RootNamespace>BetterDPSMeter</RootNamespace>
        <AssemblyName>BetterDPSMeter</AssemblyName>
        <OutputType>Library</OutputType>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
        <Deterministic>true</Deterministic>
        <Version>1.2.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="BetterDPSMeter.Tests"/>
    </ItemGroup>

    <Import Project="..\BetterDPSMeter.Local.props"
            Condition="Exists('..\BetterDPSMeter.Local.props')"/>

    <PropertyGroup>
        <TerrariaExe Condition="'$(TerrariaDirectory)' != ''">$(TerrariaDirectory)\Terraria.exe</TerrariaExe>
        <TerrariaModderCoreDll Condition="'$(TerrariaDirectory)' != ''">$(TerrariaDirectory)\TerrariaModder\core\TerrariaModder.Core.dll</TerrariaModderCoreDll>
        <HarmonyDll Condition="'$(TerrariaDirectory)' != ''">$(TerrariaDirectory)\TerrariaModder\core\deps\0Harmony.dll</HarmonyDll>
        <XnaContentPipelineDll Condition="'$(XnaContentPipelineDll)' == '' and '$(TerrariaDirectory)' != ''">$(TerrariaDirectory)\Microsoft.Xna.Framework.Content.Pipeline.dll</XnaContentPipelineDll>
        <ManifestPath>$(MSBuildThisFileDirectory)..\..\mod\manifest.json</ManifestPath>
        <DeployToGame Condition="'$(DeployToGame)' == ''">false</DeployToGame>
        <TerrariaModDirectory Condition="'$(TerrariaModDirectory)' == '' and '$(TerrariaDirectory)' != ''">$(TerrariaDirectory)\TerrariaModder\mods\better-dps-meter</TerrariaModDirectory>
    </PropertyGroup>

    <Target Name="ValidateLocalConfiguration"
            BeforeTargets="ResolveReferences">
        <Error Condition="'$(TerrariaDirectory)' == ''"
               Text="TerrariaDirectory is not configured. Create src\BetterDPSMeter.Local.props from docs\BetterDPSMeter.Local.props.example and set the Terraria installation path."/>
        <Error Condition="'$(TerrariaExe)' != '' and !Exists('$(TerrariaExe)')"
               Text="Terraria.exe was not found at '$(TerrariaExe)'. Update TerrariaDirectory in src\BetterDPSMeter.Local.props."/>
        <Error Condition="'$(TerrariaModderCoreDll)' != '' and !Exists('$(TerrariaModderCoreDll)')"
               Text="TerrariaModder.Core.dll was not found at '$(TerrariaModderCoreDll)'. Update TerrariaDirectory in src\BetterDPSMeter.Local.props."/>
        <Error Condition="'$(HarmonyDll)' != '' and !Exists('$(HarmonyDll)')"
               Text="0Harmony.dll was not found at '$(HarmonyDll)'. Update TerrariaDirectory in src\BetterDPSMeter.Local.props."/>
        <Error Condition="'$(XnaContentPipelineDll)' != '' and !Exists('$(XnaContentPipelineDll)')"
               Text="Microsoft.Xna.Framework.Content.Pipeline.dll was not found at '$(XnaContentPipelineDll)'. Update TerrariaDirectory or XnaContentPipelineDll in src\BetterDPSMeter.Local.props."/>
        <Error Condition="'$(DeployToGame)' == 'true' and '$(TerrariaModDirectory)' == ''"
               Text="TerrariaModDirectory is not configured while DeployToGame is enabled."/>
    </Target>

    <ItemGroup Condition="'$(TerrariaDirectory)' != ''">
        <Reference Include="Terraria">
            <HintPath>$(TerrariaExe)</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="TerrariaModder.Core">
            <HintPath>$(TerrariaModderCoreDll)</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="0Harmony">
            <HintPath>$(HarmonyDll)</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="Microsoft.Xna.Framework.Content.Pipeline"
                   Condition="'$(XnaContentPipelineDll)' != ''">
            <HintPath>$(XnaContentPipelineDll)</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <Target Name="DeployModToGame"
            AfterTargets="Build"
            Condition="'$(DeployToGame)' == 'true' and '$(TerrariaModDirectory)' != ''">
        <Error Condition="!Exists('$(ManifestPath)')"
               Text="TerrariaModder manifest was not found at '$(ManifestPath)'."/>
        <MakeDir Directories="$(TerrariaModDirectory)"/>
        <Copy SourceFiles="$(TargetPath);$(ManifestPath)"
              DestinationFolder="$(TerrariaModDirectory)"
              SkipUnchangedFiles="true"/>
    </Target>
</Project>